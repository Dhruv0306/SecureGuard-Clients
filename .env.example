# Copy this file to .env (git ignores it) and fill it in.
#
# abuse.ch Auth-Key, used to sync malware signatures from MalwareBazaar.
# It is free: sign in at https://auth.abuse.ch/ and create an Auth-Key.
# Keep it secret and never commit it.
# The command line tool and `cargo tauri dev` (a debug build) read this file. An installed
# desktop app does not: paste the key into the app instead (or set a real environment variable).
# ABUSECH_AUTH_KEY is accepted as another name; ABUSE_CH_AUTH_KEY wins when both are set.
ABUSE_CH_AUTH_KEY=

# Rust
/target/
**/target/
Cargo.lock

# Node (Tauri CLI, desktop app)
node_modules/
desktop/src-tauri/gen/

# Tauri-generated icons (see desktop/src-tauri/icons/README.md)
desktop/src-tauri/icons/*.png
desktop/src-tauri/icons/*.icns
desktop/src-tauri/icons/*.ico
!desktop/src-tauri/icons/README.md

# Local databases created by running scg-scan or the desktop app
*.db
*.sqlite

# Editor/OS noise
.vscode/
.idea/
.DS_Store

# Ignore the .env file if it exists, but keep the example file
.env
.env.*
!.env.example

# Ignore .patch and .bundle files created by the desktop app
*.patch
*.bundle